rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin or super admin
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super admin');
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is a photographer (by email match)
    function isPhotographer(photographerEmail) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == photographerEmail;
    }
    
    // Helper function to check if user owns the photographer booking
    function ownsBooking(photographerId) {
      return isAuthenticated() && 
             resource.data.photographerId == photographerId &&
             exists(/databases/$(database)/documents/photographers/$(photographerId)) &&
             get(/databases/$(database)/documents/photographers/$(photographerId)).data.email == 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email;
    }

    // Users collection
    match /users/{userId} {
      // Allow read if authenticated user is reading their own document OR if admin
      // This also allows Storage rules to check user roles when evaluating security
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && 
                      (!('role' in request.resource.data) || 
                       request.resource.data.role == resource.data.role ||
                       isAdmin());
      allow delete: if isAdmin();
    }

    // Photographers collection
    match /photographers/{photographerId} {
      allow read: if true;
      allow create: if isAdmin() || 
                      (isAuthenticated() && 
                       (request.resource.data.email == request.auth.token.email ||
                        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                         request.resource.data.email == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email)));
      allow update: if isAdmin() || 
                     (isAuthenticated() && 
                      (resource.data.email == request.auth.token.email ||
                       (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                        resource.data.email == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email)));
      allow delete: if isAdmin(); // Only admins can delete
    }

    // Posters collection
    match /posters/{posterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Ebooks collection
    match /ebooks/{ebookId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Cap Designs collection
    match /capDesigns/{designId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System logs collection
    match /systemLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Photographer Bookings collection
    match /photographerBookings/{bookingId} {
      allow read: if isAdmin() || 
                    (isAuthenticated() && 
                     exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                     resource.data.photographerId != null &&
                     exists(/databases/$(database)/documents/photographers/$(resource.data.photographerId)) &&
                     get(/databases/$(database)/documents/photographers/$(resource.data.photographerId)).data.email == 
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email);
      allow create: if isAuthenticated(); // Any authenticated user can create bookings
      allow update: if isAdmin() || 
                      (isAuthenticated() && 
                       exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                       resource.data.photographerId != null &&
                       exists(/databases/$(database)/documents/photographers/$(resource.data.photographerId)) &&
                       get(/databases/$(database)/documents/photographers/$(resource.data.photographerId)).data.email == 
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email);
      allow delete: if isAdmin(); // Only admins can delete bookings
    }

    // Scholarship Submissions collection
    match /scholarshipSubmissions/{submissionId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated(); // Any authenticated user can create submissions
      allow update, delete: if isAdmin(); // Only admins can update/delete submissions
    }

    // Platform settings — admins write; members may read (discount code for Fotomatic UI)
    match /platformSettings/{docId} {
      allow read: if isAdmin() || (isAuthenticated() && docId == 'main');
      allow write: if isAdmin();
    }

    // Passkey access requests — created only via Firebase Admin (API routes)
    match /passkeyRequests/{requestId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Travel Interests collection (HoS Travel Experience) — created via Admin API only
    match /travelInterests/{interestId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Public grad driver directory (synced from users/{uid} by the client).
    // Split get vs list: queries only use directoryVisible, but OR with owner caused
    // list permission failures (rules broader than query). Owner can still get own doc.
    match /gradDriverProfiles/{userId} {
      allow get: if isAuthenticated() && (
        resource.data.directoryVisible == true ||
        request.auth.uid == userId
      );
      allow list: if isAuthenticated() && resource.data.directoryVisible == true;
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Grad Community: connection requests between members
    match /connectionRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow create: if isAuthenticated() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.toUid is string &&
        request.resource.data.fromUid != request.resource.data.toUid;
      allow update: if isAuthenticated() &&
        resource.data.toUid == request.auth.uid &&
        resource.data.status == 'pending';
      allow delete: if false;
    }

    match /connections/{connectionId} {
      allow read: if isAuthenticated() &&
        request.auth.uid in resource.data.memberUids;
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.memberUids;
      allow update, delete: if false;
    }

    match /conversations/{conversationId} {
      allow read, update: if isAuthenticated() &&
        request.auth.uid in resource.data.participantUids;
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.participantUids;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
        allow create: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids &&
          request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
