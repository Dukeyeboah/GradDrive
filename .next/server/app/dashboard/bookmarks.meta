{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/bookmarks/layout,_N_T_/dashboard/bookmarks/page,_N_T_/dashboard/bookmarks"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/bookmarks/__PAGE__",
    "/dashboard/bookmarks",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}