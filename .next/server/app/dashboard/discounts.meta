{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/discounts/layout,_N_T_/dashboard/discounts/page,_N_T_/dashboard/discounts"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/discounts/__PAGE__",
    "/dashboard/discounts",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}